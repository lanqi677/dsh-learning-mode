{
  "name": "dsh-learning-mode",
  "version": "0.2.0",
  "private": true,
  "description": "DSH 学习模式：一棵由 AI 维护的、可无限下钻的学习树 + 自动摘要 + 复习视图。宿主插件只挂在「学习模式」agent 预设里，普通会话零影响。",
  "type": "module",
  "main": "lib/client-host.js",
  "exports": {
    ".": "./lib/client-host.js",
    "./host": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "scripts": {
    "test": "node test/smoke.mjs && node test/mount.mjs && node test/summary.mjs && node test/client.mjs && node test/probe.mjs",
    "install:preset": "node install.mjs",
    "install:profile": "node scripts/setup-profile.mjs",
    "link:deps": "node scripts/link-harness-deps.mjs",
    "validate:preset": "node scripts/validate-preset.mjs",
    "verify:live": "node scripts/verify-live.mjs",
    "backfill:origins": "node scripts/backfill-origins.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "license": "MIT"
}
